# Copy this file to `.env` and fill in your own key.
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
#
# This variable is read ONLY by the server-side function in `api/analyze.js`.
# It has no `VITE_` prefix, so Vite never inlines it into the client bundle —
# the key stays on the server and is never exposed to the browser.
#
# On Vercel, set the same variable under Project Settings > Environment Variables.
GEMINI_API_KEY=your_gemini_api_key_here
